---
import Base from '@/layouts/Base.astro'
---

<Base lang="en" title="Page not found, Piotr Ponikiewski" description="This page does not exist." noindex>
  <section class="not-found page" aria-labelledby="not-found-title">
    <p class="not-found-code">404</p>
    <h1 id="not-found-title">This page does not exist.</h1>
    <p class="lead">The address may be mistyped, or the page has moved.</p>
    <p class="actions">
      <a class="button" href="/">Go to the home page</a>
      <a class="button ghost" href="/pl/" hreflang="pl" lang="pl">Strona główna po polsku</a>
    </p>
  </section>
</Base>
