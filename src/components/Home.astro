---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import Base from '@/layouts/Base.astro'
import ProjectCard from '@/components/ProjectCard.astro'
import Activity from '@/components/Activity.astro'
import photo from '@/assets/photo.png'
import { contact, cvHref, ui, type Lang } from '@/i18n/ui'
import { getContributions } from '@/lib/github'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
const projects = allProjects.filter((project) => project.data.featured)
// The link to /projects/ only earns its place once there is more there than on this page.
const hasMoreProjects = allProjects.length > projects.length
const contributions = await getContributions()
---

<Base lang={lang} title={t.meta.title} description={t.meta.description} translated>
  <section class="hero page" aria-labelledby="hero-title">
    <h1 id="hero-title">{t.hero.title}</h1>
    <p class="lead">{t.hero.lead}</p>
    <p class="actions">
      <a class="button" href={cvHref(lang)} download>{t.hero.cv}</a>
      <a class="button ghost" href={contact.github}>GitHub</a>
    </p>
  </section>

  <section id="work" class="section page" aria-labelledby="work-title">
    <h2 id="work-title" class="section-label">{t.work.heading}</h2>
    <div class="section-body projects">
      {projects.map((project) => <ProjectCard project={project} lang={lang} morph />)}
      {
        hasMoreProjects && (
          <a class="button ghost all-projects" href="/projects/" lang={lang === 'pl' ? 'en' : undefined}>
            {t.work.all}
          </a>
        )
      }
    </div>
  </section>

  {
    contributions && (
      <section id="activity" class="section page" aria-labelledby="activity-title">
        <h2 id="activity-title" class="section-label">
          {t.activity.heading}
        </h2>
        <div class="section-body activity">
          <Activity data={contributions} lang={lang} />
        </div>
      </section>
    )
  }

  <section id="about" class="section page" aria-labelledby="about-title">
    <h2 id="about-title" class="section-label">{t.about.heading}</h2>
    <div class="section-body about">
      <Image src={photo} alt={t.about.photoAlt} width={142} densities={[1, 2]} class="photo" />
      <div class="prose">
        {t.about.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section id="contact" class="section page" aria-labelledby="contact-title">
    <h2 id="contact-title" class="section-label">{t.contact.heading}</h2>
    <div class="section-body contact">
      <p>{t.contact.lead}</p>
      <a class="email" href={`mailto:${contact.email}`}>{contact.email}</a>
      <dl class="contact-list">
        <div>
          <dt>{t.contact.phone}</dt>
          <dd><a href={`tel:${contact.phone.replaceAll(' ', '')}`}>{contact.phone}</a></dd>
        </div>
        <div>
          <dt>GitHub</dt>
          <dd><a href={contact.github}>github.com/pponikiewski</a></dd>
        </div>
      </dl>
    </div>
  </section>
</Base>
